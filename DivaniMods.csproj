<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <AssemblyName>DivaniMods</AssemblyName>
    <RootNamespace>DivaniMods</RootNamespace>
    <Version>1.3.6</Version>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
    <NoWarn>$(NoWarn);NU1605</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);TownOfUs\**\*;TouMiraRolesExtension\**\*;TheOtherRolesGMIA-main\**\*;.specstory\**\*</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup>
    <AmongUsPath Condition="'$(AmongUsPath)' == ''">C:\Users\dylan\Desktop\modtest</AmongUsPath>
    <BepInExPath>$(AmongUsPath)\BepInEx</BepInExPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TownOfUsMira" Version="1.7.1-ci.1464" />
    <PackageReference Include="AllOfUs.MiraAPI" Version="0.4.3"/>
    <PackageReference Include="Reactor" Version="2.5.0-ci.371"/>
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.735" Private="false" ExcludeAssets="runtime;native"/>
    <PackageReference Include="AmongUs.GameLibs.Steam" Version="2026.3.31" PrivateAssets="all"/>

    <PackageReference Include="BepInEx.AutoPlugin" Version="1.1.0" PrivateAssets="all"/>
    <PackageReference Include="BepInEx.IL2CPP.MSBuild" Version="2.1.0-rc.1" PrivateAssets="all" ExcludeAssets="runtime"/>
    <PackageReference Include="PerfectComms.Api" Version="4.1.7.1" PrivateAssets="all" />
  </ItemGroup>


  <ItemGroup>
    <EmbeddedResource Include="Resources\**\*" Exclude="Resources\Headers\**" />
  </ItemGroup>

  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="Exists('$(BepInExPath)\plugins')">
    <Copy SourceFiles="$(OutputPath)DivaniMods.dll" DestinationFolder="/Users/neiljain/Library/Application Support/CrossOver/Bottles/Mainly/drive_c/Program Files (x86)/Steam/steamapps/common/Among Us copy/BepInEx/plugins" />
    <Message Text="Copied $(AssemblyName).dll to BepInEx plugins folder!" Importance="High" />
  </Target>

</Project>
