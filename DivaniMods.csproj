<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <AssemblyName>DivaniMods</AssemblyName>
    <RootNamespace>DivaniMods</RootNamespace>
    <Version>1.4.0</Version>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
    <NoWarn>$(NoWarn);NU1605</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);TownOfUs\**\*;TouMiraRolesExtension\**\*;TheOtherRolesGMIA-main\**\*;.specstory\**\*</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup>
    <AmongUsPath Condition="'$(AmongUsPath)' == ''">C:\Users\dylan\Desktop\modtest</AmongUsPath>
    <BepInExPath>$(AmongUsPath)\BepInEx</BepInExPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TownOfUsMira" Version="1.7.3-ci.1669" />
    <PackageReference Include="AllOfUs.MiraAPI" Version="0.5.0"/>
    <PackageReference Include="Reactor" Version="2.5.1-ci.384"/>
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.735" Private="false" ExcludeAssets="runtime;native"/>
    <PackageReference Include="AmongUs.GameLibs.Steam" Version="2026.9.29" PrivateAssets="all"/>

    <PackageReference Include="BepInEx.AutoPlugin" Version="1.1.0" PrivateAssets="all"/>
    <PackageReference Include="BepInEx.IL2CPP.MSBuild" Version="2.1.0-rc.1" PrivateAssets="all" ExcludeAssets="runtime"/>
    <PackageReference Include="PerfectComms.Api" Version="4.1.7.1" PrivateAssets="all" />
  </ItemGroup>


  <ItemGroup>
    <EmbeddedResource Include="Resources\**\*" Exclude="Resources\Headers\**" />
  </ItemGroup>

 <Target Name="CopyDllToAnotherFolder" AfterTargets="Build">
        <Copy SourceFiles="$(TargetDir)$(TargetName).dll" 
        DestinationFolder="/Users/neiljain/Library/Application Support/CrossOver/Bottles/Mainly/drive_c/Program Files (x86)/Steam/steamapps/common/Among Us copy/BepInEx/plugins" 
        SkipUnchangedFiles="true" />
</Target>

</Project>
